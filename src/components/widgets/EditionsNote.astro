---
import { Icon } from 'astro-icon/components';
---

<section class="bg-[color:rgba(249,115,22,0.12)] dark:bg-slate-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-4 text-lg text-center font-medium">
    <span class="font-bold">
      <Icon
        name="tabler:alert-triangle"
        class="w-7 h-7 text-[color:var(--color-primary)] inline-block align-text-bottom"
      /> Set your budget and use case:</span
    >
    Drag the budget slider and select a use case. We will confirm parts and send a Stripe checkout link
    when you are ready.
  </div>
</section>
