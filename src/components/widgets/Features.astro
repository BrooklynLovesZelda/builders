---
import { Icon } from 'astro-icon/components';

const items = [
  [
    {
      title: 'Purpose-built configurations',
      description:
        'Gaming, creator, and workstation presets tuned for stable performance and upgrade headroom.',
      icon: 'tabler:cpu',
    },
    {
      title: 'Clean assembly, tested thermals',
      description:
        'Every system is stress-tested with validated thermals, quiet fan curves, and cable management.',
      icon: 'tabler:thermometer',
    },
    {
      title: 'Transparent parts list',
      description:
        'You see every part we choose, with upgrade options and pricing clarity before checkout.',
      icon: 'tabler:list-details',
    },
  ],
  [
    {
      title: 'Stripe-secured checkout',
      description:
        'Checkout is handled by Stripe for secure payments, receipts, and order confirmation.',
      icon: 'tabler:credit-card',
    },
  ],
];
---

<section class="scroll-mt-16" id="features">
  <div class="px-4 py-16 mx-auto max-w-4xl lg:px-8 lg:py-20">
    <div class="mb-10 md:mx-auto sm:text-center md:mb-12 max-w-xl">
      <p
        class="text-base text-[color:var(--color-primary)] dark:text-[color:var(--color-primary)] font-semibold tracking-wide uppercase"
      >
        Features
      </p>
      <h2 class="text-2xl md:text-3xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
        Built for performance and reliability
      </h2>
      <p class="max-w-xl mx-auto sm:text-center text-lg text-gray-600 dark:text-slate-400">
        Builders delivers custom PCs with a transparent parts list, tested thermals, and checkout you
        can trust. Choose a preset or spec your own build.
      </p>
    </div>
    <div class="grid mx-auto space-y-6 md:grid-cols-2 md:space-y-0">
      {
        items.map((subitems) => (
          <div class="space-y-8 sm:px-8">
            {subitems.map(({ title, description, icon }) => (
              <div class="flex flex-row max-w-md">
                <div class="mb-4 mr-4">
                  <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[color:var(--color-primary)] dark:bg-[color:var(--color-primary)]">
                    {icon && <Icon name={icon} class="w-6 h-6 icon-light" />}
                  </div>
                </div>
                <div>
                  <h3 class="mb-3 text-sm font-bold">{title}</h3>
                  <p class="text-gray-600 dark:text-slate-400">{description}</p>
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
