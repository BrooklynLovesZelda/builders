---
const promises = [
  {
    name: 'Hand-picked parts',
    description: 'We source reliable components and validate compatibility before we build.',
  },
  {
    name: 'Stress-tested systems',
    description: 'Every PC ships with stability testing and thermal validation.',
  },
  {
    name: 'Built to upgrade',
    description: 'Clear upgrade paths so your rig can evolve as your needs change.',
  },
];
---

<section class="py-20">
  <div class="container px-4 mx-auto">
    <div class="max-w-xl mx-auto mb-16 text-center">
      <h2 class="mt-8 text-4xl lg:text-5xl font-bold font-heading">The Builders promise</h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-slate-400">
        Transparent parts, clean builds, and reliable performance you can trust.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {
        promises.map(({ name, description }) => (
          <div class="rounded-2xl border border-slate-200 dark:border-slate-700 p-6 bg-white/60 dark:bg-slate-900/30">
            <h3 class="text-xl font-semibold mb-2">{name}</h3>
            <p class="text-gray-600 dark:text-slate-400">{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
