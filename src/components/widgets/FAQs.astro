---
import { Icon } from 'astro-icon/components';

const items = [
  [
    {
      question: 'Can I request a fully custom build?',
      answer:
        'Yes. Share your budget, games or apps, and target resolution, and we will spec the parts for you.',
    },
    {
      question: 'How does checkout work?',
      answer:
        'Once you approve the parts list, we send a Stripe Checkout link for secure payment and receipt.',
    },
    {
      question: 'What is the typical build time?',
      answer:
        'Most builds ship in 7-10 business days depending on parts availability.',
    },
  ],
  [
    {
      question: 'Do you test systems before shipping?',
      answer:
        'Every PC is stress-tested for stability, thermals, and noise levels before it leaves the bench.',
    },
    {
      question: 'Can I upgrade later?',
      answer:
        'We choose parts with upgrade headroom so you can expand RAM, storage, or GPU down the line.',
    },
    {
      question: 'Do you offer local pickup?',
      answer:
        'Ask when you request a quote and we will confirm pickup options based on your location.',
    },
  ],
];
---

<div class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
  <div class="max-w-xl sm:mx-auto lg:max-w-2xl">
    <div class="max-w-xl mb-10 md:mx-auto sm:text-center lg:max-w-2xl md:mb-12">
      <h2
        class="max-w-lg mb-4 text-3xl font-bold leading-none tracking-tight sm:text-4xl md:mx-auto font-heading"
      >
        Frequently Asked Questions
      </h2>
    </div>
  </div>
  <div class="max-w-(--breakpoint-xl) sm:mx-auto">
    <div class="grid grid-cols-1 gap-x-8 gap-y-8 lg:gap-x-16 md:grid-cols-2">
      {
        items.map((subitems) => (
          <div class="space-y-8">
            {subitems.map(({ question, answer }) => (
              <div>
                <p class="mb-4 text-xl font-bold">
                  <Icon
                    name="tabler:arrow-down-right"
                    class="w-7 h-7 text-[color:var(--color-primary)] inline-block"
                  />
                  {question}
                </p>
                <p class="text-gray-700 dark:text-gray-400 mb-2">{answer}</p>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</div>
