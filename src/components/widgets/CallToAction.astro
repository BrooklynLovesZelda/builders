---
import { Icon } from 'astro-icon/components';
---

<section class="relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-12 md:py-20">
      <div
        class="max-w-3xl mx-auto text-center p-6 rounded-md shadow-xl dark:shadow-none dark:border dark:border-slate-600"
      >
        <h2
          class="text-4xl md:text-4xl font-bold leading-tighter tracking-tighter mb-4 font-heading"
        >
          <span>Ready</span> to <br class="block sm:hidden" />
          <span class="sm:whitespace-nowrap">build your rig?</span>
        </h2>
        <p class="text-xl text-gray-600 dark:text-slate-400">
          Start a custom PC configuration and we will send a Stripe checkout when everything looks right.
        </p>

        <div class="mt-6 max-w-xs mx-auto">
          <a class="btn btn-primary w-full sm:w-auto" href="/download#selector">
            <Icon name="tabler:bolt" class="w-5 h-5 mr-1 -ml-1.5" /> Set your budget
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
